rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /company_data/{fileName} {
      allow read: if isAdmin();
      // Warranty_Ledger.xlsx / Warranty_Flat.xlsx are the source files —
      // only the Cloud Function (Admin SDK, which bypasses these rules)
      // should write them now. Customer_Master.xlsx is still exported
      // directly from the client (updateCloudExcel), so it stays
      // admin-writable.
      allow write: if isAdmin()
        && fileName != 'Warranty_Ledger.xlsx'
        && fileName != 'Warranty_Flat.xlsx';
    }
    match /billproff/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // technicians and admin both generate bills here
    }
    match /quotations/{fileName} {
      allow read, write: if isAdmin();
    }
    match /{allPaths=**} {
      allow read, write: if false;  // deny anything not explicitly matched above
    }
  }
}